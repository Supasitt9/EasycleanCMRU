{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".*",
      "**/.*",
      "**/node_modules/**",
      "**/data/**",
      "**/*.rules",
      "**/server.js",
      "**/package*.json",
      "**/README.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
